{
  "mcpServers": {
    "context7": {
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "io.github.firebase/firebase-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools",
        "mcp"
      ],
      "env": {},
      "enabled": true,
      "trust": false,
      "includeTools": [],
      "excludeTools": []
    },
    "com.figma.mcp/mcp": {
      "httpUrl": "https://mcp.figma.com/mcp",
      "headers": {},
      "timeout": -1,
      "enabled": true,
      "trust": false,
      "includeTools": [],
      "excludeTools": []
    }
  }
}
